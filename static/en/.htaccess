# Английские адреса: своя страница 404. Корневой .htaccess отдаёт русскую
# /404.html на любой несуществующий адрес, в том числе под /en/; этот файл
# лежит в /en/ и перекрывает его для всего раздела. <If> в корневом файле
# не нужен — директива та же, что уже работает на хостинге.
ErrorDocument 404 /en/404.html
