# Custom 404
ErrorDocument 404 /404.html

# Cache-Control headers
<IfModule mod_expires.c>
  ExpiresActive On

  # Fonts — 1 year (immutable)
  ExpiresByType font/woff2 "access plus 1 year"

  # Images — 1 month
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"

  # CSS/JS — 1 week
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # HTML — no cache (always fresh)
  ExpiresByType text/html "access plus 0 seconds"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # Fonts — immutable
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images
  <FilesMatch "\.(jpe?g|png|ico|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # CSS/JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # С отпечатком в имени (конвейер Hugo: main.min.<sha256>.css, баннеры,
  # фото основателя) — год и immutable: новая версия приходит под новым
  # именем, старую держать в кеше безопасно. Стоит после общих правил,
  # чтобы перекрыть их
  <FilesMatch "\.[0-9a-f]{64}\.(css|js|jpe?g|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — revalidate every time
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # HSTS на полгода: браузер, хоть раз открывший сайт, дальше ходит только по
  # https — даже по старой ссылке с http:// или адресу, набранному без протокола.
  # Цена: если сломается сертификат, такие посетители не откроют сайт, пока его
  # не починят (сейчас Let's Encrypt, хостинг продлевает сам). Без поддоменов.
  # always — заголовок уходит и с ответами 404 и редиректами
  Header always set Strict-Transport-Security "max-age=15768000"
</IfModule>
